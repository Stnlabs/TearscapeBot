<Window x:Class="TearscapeBot.Welcome_Module.Step4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TearscapeBot.Welcome_Module"
        mc:Ignorable="d"
        Title="Step3" Height="450" Width="800">
    <Grid>
        <Label Content="Step4 - Twitch Channel" HorizontalAlignment="Left" Margin="38,24,0,0" VerticalAlignment="Top" FontSize="30" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="38,0,0,0" TextWrapping="Wrap" Text="We're close to the end of the introduction. What we need now is the Twitch channel name where you want to use your Bot. Enter it and you're done. Congratulations :=)" VerticalAlignment="Center" Height="255" Width="410" FontSize="20" FontStyle="Italic"/>
        <Label Content="Enter Channel" HorizontalAlignment="Left" Margin="520,90,0,0" VerticalAlignment="Top" Height="55" Width="175" FontSize="20"/>
        <Button Content="Start" HorizontalAlignment="Left" Margin="520,249,0,0" VerticalAlignment="Top" Height="50" Width="170" FontSize="20" Click="BTNStartClick"/>
        <TextBox x:Name="TwitchChannel" HorizontalAlignment="Left" Margin="520,150,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="170" Height="44" TextChanged="Twitch_Channel"/>
    </Grid>
</Window>
