<Window x:Class="TearscapeBot.Welcome_Module.Step3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TearscapeBot.Welcome_Module"
        mc:Ignorable="d"
        Title="Step_2" Height="450" Width="800">
    <Grid>
        <Label Content="Step 3 - Create Authtoken" HorizontalAlignment="Left" Margin="29,34,0,0" VerticalAlignment="Top" Width="426" FontSize="30" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="29,89,0,0" TextWrapping="Wrap" Text="Secound, we need to get the authtoken from the twitch page, all you need to do is to follow the link below and copy the link into the field." VerticalAlignment="Top" Height="290" Width="341" FontSize="30" FontStyle="Italic"/>
        <TextBlock Margin="520,34,98,301" FontSize="30">
     <Hyperlink NavigateUri="https://dev.twitch.tv" RequestNavigate="Changeurl">
         Click here
     </Hyperlink>
        </TextBlock>
        <Button Content="ToStep3" HorizontalAlignment="Left" Margin="520,304,0,0" VerticalAlignment="Top" Height="45" Width="145" FontSize="20" FontWeight="Bold" Click="Tostep3"/>
        <TextBox x:Name="TxtBauthtoken" HorizontalAlignment="Left" Margin="520,0,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Center" Width="202" Height="50" TextChanged="Authtoken" FontSize="30" />
        <Label Content="Enter Link" HorizontalAlignment="Left" Margin="520,143,0,0" VerticalAlignment="Top" Height="49" Width="185" FontSize="20" />
    </Grid>
</Window>
