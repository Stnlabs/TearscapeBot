<Window x:Class="TearscapeBot.Welcome_Module.Step2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TearscapeBot.Welcome_Module"
        mc:Ignorable="d"
        Title="Step2" Height="450" Width="800">
    <Grid>
        <Label Content="Step 2 - Client ID registration" HorizontalAlignment="Left" Margin="40,24,0,0" VerticalAlignment="Top" Height="80" Width="440" FontSize="30" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="40,91,0,0" TextWrapping="Wrap" Text="Now after you registered your bot, please copy here your client id from the twitch developer site into the field and follow the link to the next step" VerticalAlignment="Top" Height="263" Width="440" FontSize="30" FontStyle="Italic"/>
        <TextBlock Margin="520,34,98,301" FontSize="30">
<Hyperlink NavigateUri="https://dev.twitch.tv" RequestNavigate="Clientidurl">
    Click here
</Hyperlink>
        </TextBlock>
        <TextBox x:Name="clientidfield" HorizontalAlignment="Left" Margin="520,138,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="182" Height="41" TextChanged="ClientIDfield"/>
        <Button Content="ToStep3" HorizontalAlignment="Left" Margin="520,279,0,0" VerticalAlignment="Top" Height="40" Width="182" FontSize="30" Click="ToStep3"/>
    </Grid>
</Window>
