<Window x:Class="TearscapeBot.Welcome_Module.Step1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TearscapeBot.Welcome_Module"
        mc:Ignorable="d"
        Title="Step1" Height="455" Width="800">
    <Grid>
        <TextBlock Margin="502,25,117,310" FontSize="30">
            <Hyperlink NavigateUri="https://dev.twitch.tv" RequestNavigate="Twitchrequestnavigate">
                Click here
            </Hyperlink>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Text="First of all make sure you have a secound Twitch account. You need to create one as a developer.The link will lead you to the developer site and copy the name into the field below." VerticalAlignment="Top" Height="387" FontSize="30" FontStyle="Italic" Margin="10,55,0,0" Width="480"/>
        <Label Content="Step 1 - Developer Account" HorizontalAlignment="Left" Margin="32,0,0,0" VerticalAlignment="Top" Width="426" FontSize="30" FontWeight="Bold"/>
        <Button Content="To Step 2" HorizontalAlignment="Left" Margin="502,304,0,0" VerticalAlignment="Top" Height="45" Width="130" FontSize="20" Click="Tostep2"/>
        <TextBox x:Name="Username" HorizontalAlignment="Left" Margin="502,175,0,0" TextWrapping="Wrap" BorderThickness="2" Text="" VerticalAlignment="Top" Width="235" Height="45" FontSize="30" TextChanged="Devname"/>
        <Label Content="Enter Username" HorizontalAlignment="Left" Margin="502,114,0,0" VerticalAlignment="Top" Height="61" Width="235" FontSize="20"/>
    </Grid>
</Window>